{
  "name": "@ontahi/react",
  "version": "1.0.0",
  "description": "Non-visual React hooks and bridge adapters for Ontahi applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "require": "./dist/actions/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js",
      "require": "./dist/graph/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.51.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
