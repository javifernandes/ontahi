{
  "name": "@ontahi/example-todo-express",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "pnpm exec tsc -p tsconfig.build.json",
    "build:client": "pnpm exec vite build",
    "codegen": "ontahi-codegen --format oxfmt",
    "codegen:check": "ontahi-codegen --format oxfmt --check",
    "dev": "pnpm exec tsx watch --include '../../packages/*/dist/**/*' src/server.ts",
    "dev:postgres": "TODO_STORAGE=postgres DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/ontahi_todos pnpm exec tsx watch src/server.ts",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "prestart": "pnpm -w build:packages && pnpm run codegen && pnpm run build:client",
    "start": "pnpm exec tsx src/server.ts",
    "test": "TODO_AUTH_MODE=github pnpm exec vitest run",
    "typecheck": "pnpm run codegen:check && pnpm exec tsc -p tsconfig.json && pnpm exec tsc -p client/tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" \"client/**/*.{ts,tsx}\" \"test/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "@ontahi/explorer-react": "workspace:*",
    "@ontahi/postgres": "workspace:*",
    "@ontahi/react": "workspace:*",
    "@ontahi/runtime-express": "workspace:*",
    "@tanstack/react-query": "^5.51.0",
    "effect": "^3.21.0",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "lucide-react": "^0.576.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@ontahi/codegen": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.53.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
