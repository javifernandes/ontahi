{
  "name": "@ontahi/postgres",
  "version": "0.1.0-alpha.7",
  "description": "Direct PostgreSQL data graph runtime for Ontahi",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/postgres",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/postgres"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./data-graph": {
      "types": "./dist/data-graph/index.d.ts",
      "import": "./dist/data-graph/index.js",
      "require": "./dist/data-graph/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:unit": "pnpm exec vitest run src/data-graph/sql.test.ts",
    "test:integration": "pnpm exec vitest run src/data-graph/postgres-runtime.integration.test.ts",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "@types/pg": "^8.23.1",
    "effect": "^3.22.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@ontahi/runtime-express": "workspace:*",
    "@testcontainers/postgresql": "^11.7.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "express": "^4.22.2",
    "testcontainers": "^11.7.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
