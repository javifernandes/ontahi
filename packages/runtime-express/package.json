{
  "name": "@ontahi/runtime-express",
  "version": "0.1.0-alpha.7",
  "description": "Express runtime and transport adapters for Ontahi applications",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/runtime-express",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/runtime-express"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/operation-invocation/index.js",
  "types": "dist/operation-invocation/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/operation-invocation/index.d.ts",
      "import": "./dist/operation-invocation/index.js",
      "require": "./dist/operation-invocation/index.js"
    },
    "./operation-invocation": {
      "types": "./dist/operation-invocation/index.d.ts",
      "import": "./dist/operation-invocation/index.js",
      "require": "./dist/operation-invocation/index.js"
    },
    "./graph-read": {
      "types": "./dist/graph-read/index.d.ts",
      "import": "./dist/graph-read/index.js",
      "require": "./dist/graph-read/index.js"
    },
    "./graph-command": {
      "types": "./dist/graph-command/index.d.ts",
      "import": "./dist/graph-command/index.js",
      "require": "./dist/graph-command/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer/index.d.ts",
      "import": "./dist/explorer/index.js",
      "require": "./dist/explorer/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "@ontahi/explorer-react": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "effect": "3.21.0",
    "express": "^4.22.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@ontahi/explorer-react": "workspace:*",
    "express": ">=4.18 <6"
  },
  "peerDependenciesMeta": {
    "@ontahi/explorer-react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
