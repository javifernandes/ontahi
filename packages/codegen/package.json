{
  "name": "@ontahi/codegen",
  "version": "0.1.0-alpha.0",
  "description": "Build-time analysis and code generation primitives for Ontahi applications",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/bookops.git",
    "directory": "ontahi/packages/codegen"
  },
  "homepage": "https://github.com/javifernandes/bookops/tree/main/ontahi/packages/codegen",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/index.mjs",
  "types": "./types/index.d.mts",
  "files": [
    "src",
    "types"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./operation-contracts": {
      "types": "./types/operation-contracts.d.mts",
      "import": "./src/operation-contracts/metadata-analyzer.mjs"
    },
    "./application": {
      "types": "./types/application.d.mts",
      "import": "./src/application-analysis.mjs"
    },
    "./projections": {
      "types": "./types/projections.d.mts",
      "import": "./src/projections.mjs"
    },
    "./runner": {
      "types": "./types/runner.d.mts",
      "import": "./src/runner.mjs"
    },
    "./source-loader": {
      "types": "./types/source-loader.d.mts",
      "import": "./src/source-loader.mjs"
    }
  },
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/application-analysis.mjs && node --check src/source-loader.mjs && node --check src/operation-contracts/metadata-analyzer.mjs && node --check src/projections.mjs && node --check src/runner.mjs && pnpm exec tsc -p tsconfig.types.json",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
