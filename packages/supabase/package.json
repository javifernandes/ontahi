{
  "name": "@ontahi/supabase",
  "version": "1.0.0-alpha.11",
  "description": "Supabase adapters for Ontahi graph and task runtimes",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/supabase",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/supabase"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./data-graph": {
      "types": "./dist/data-graph/index.d.ts",
      "import": "./dist/data-graph/index.js",
      "require": "./dist/data-graph/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "import": "./dist/tasks/index.js",
      "require": "./dist/tasks/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.0.18",
    "pg": "^8.16.3",
    "testcontainers": "^11.7.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
