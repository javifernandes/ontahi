{
  "name": "@ontahi/example-todo-express",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "pnpm exec tsc -p tsconfig.build.json",
    "build:client": "pnpm exec vite build",
    "codegen": "node scripts/generate-client.mjs",
    "codegen:check": "node scripts/generate-client.mjs --check",
    "dev": "pnpm exec tsx watch src/server.ts",
    "prestart": "pnpm -w build:ontahi-core && pnpm -w build:ontahi-react && pnpm -w build:ontahi-runtime-express && pnpm run codegen && pnpm run build:client",
    "start": "pnpm exec tsx src/server.ts",
    "test": "pnpm exec vitest run",
    "typecheck": "pnpm run codegen:check && pnpm exec tsc -p tsconfig.json && pnpm exec tsc -p client/tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" \"client/**/*.{ts,tsx}\" \"test/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "@ontahi/react": "workspace:*",
    "@ontahi/runtime-express": "workspace:*",
    "@tanstack/react-query": "^5.51.0",
    "effect": "^3.21.0",
    "express": "^4.22.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@ontahi/codegen": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
