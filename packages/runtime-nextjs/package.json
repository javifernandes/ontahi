{
  "name": "@ontahi/runtime-nextjs",
  "version": "1.0.0-alpha.8",
  "description": "Next.js runtime and transport adapters for Ontahi applications",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/runtime-nextjs",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/runtime-nextjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/actions/index.js",
  "types": "dist/actions/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "require": "./dist/actions/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "require": "./dist/actions/index.js"
    },
    "./actions/server": {
      "types": "./dist/actions/server.d.ts",
      "import": "./dist/actions/server.js",
      "require": "./dist/actions/server.js"
    },
    "./operation-invocation": {
      "types": "./dist/operation-invocation/index.d.ts",
      "import": "./dist/operation-invocation/index.js",
      "require": "./dist/operation-invocation/index.js"
    },
    "./graph-read": {
      "types": "./dist/graph-read/index.d.ts",
      "import": "./dist/graph-read/index.js",
      "require": "./dist/graph-read/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "effect": "^3.21.0",
    "next-safe-action": "^8.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "next": ">=14.2.0 <17",
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
