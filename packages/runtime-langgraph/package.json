{
  "name": "@ontahi/runtime-langgraph",
  "version": "1.0.0-alpha.12",
  "description": "LangGraph runtime integration for Ontahi durable tasks",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/runtime-langgraph",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/runtime-langgraph"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.18",
    "@ontahi/core": "workspace:*",
    "effect": "^3.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
