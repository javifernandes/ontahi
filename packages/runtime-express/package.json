{
  "name": "@ontahi/runtime-express",
  "version": "1.0.0",
  "description": "Express runtime and transport adapters for Ontahi applications",
  "main": "dist/operation-invocation/index.js",
  "types": "dist/operation-invocation/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/operation-invocation/index.d.ts",
      "import": "./dist/operation-invocation/index.js",
      "require": "./dist/operation-invocation/index.js"
    },
    "./operation-invocation": {
      "types": "./dist/operation-invocation/index.d.ts",
      "import": "./dist/operation-invocation/index.js",
      "require": "./dist/operation-invocation/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*",
    "@ontahi/explorer-react": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4.18 <6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "express": "^4.22.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
