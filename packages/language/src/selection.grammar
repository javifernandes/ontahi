@top SelectionDocument { OrExpression? }
@top ConsoleDocument { ConsoleExpression? }

ConsoleExpression { GraphReadExpression }
GraphReadExpression {
  EntityName
  (Dot Where OpenParen OrExpression CloseParen)?
  (Dot Limit OpenParen NumberLiteral CloseParen)?
  Dot ReadTerminal OpenParen CloseParen
}
EntityName { Identifier }
ReadTerminal { First | One | Many | Count }

OrExpression { AndExpression (Or AndExpression)* }
AndExpression { NotExpression (And NotExpression)* }
NotExpression { Not* PrimaryExpression }
PrimaryExpression { All | None | Predicate | ParenthesizedExpression }
ParenthesizedExpression { OpenParen OrExpression CloseParen }

Predicate { EqualityPredicate | MembershipPredicate | NullPredicate | ComparisonPredicate }
EqualityPredicate { FieldName Equals ScalarLiteral }
MembershipPredicate { FieldName In ListLiteral }
NullPredicate { FieldName Is Null }
ComparisonPredicate { FieldName ComparisonOperator ScalarLiteral }

FieldName { Identifier }
ScalarLiteral { StringLiteral | NumberLiteral | BooleanLiteral }
BooleanLiteral { True | False }
ListLiteral { OpenBracket (ScalarLiteral (Comma ScalarLiteral)*)? CloseBracket }

All { @specialize<Identifier, "all"> }
None { @specialize<Identifier, "none"> }
And { @specialize<Identifier, "and"> }
Or { @specialize<Identifier, "or"> }
Not { @specialize<Identifier, "not"> }
In { @specialize<Identifier, "in"> }
Is { @specialize<Identifier, "is"> }
Null { @specialize<Identifier, "null"> }
True { @specialize<Identifier, "true"> }
False { @specialize<Identifier, "false"> }
Where { @specialize<Identifier, "where"> }
First { @specialize<Identifier, "first"> }
One { @specialize<Identifier, "one"> }
Many { @specialize<Identifier, "many"> }
Count { @specialize<Identifier, "count"> }
Limit { @specialize<Identifier, "limit"> }

Equals { "=" }
ComparisonOperator { LessThanOrEqual | GreaterThanOrEqual | LessThan | GreaterThan }
LessThanOrEqual { "<=" }
GreaterThanOrEqual { ">=" }
LessThan { "<" }
GreaterThan { ">" }
OpenParen { "(" }
CloseParen { ")" }
OpenBracket { "[" }
CloseBracket { "]" }
Comma { "," }
Dot { "." }

@tokens {
  Identifier { $[A-Za-z_] $[A-Za-z0-9_]* }
  NumberLiteral { "-"? ("0" | $[1-9] $[0-9]*) ("." $[0-9]+)? ($[eE] ("+" | "-")? $[0-9]+)? }
  StringLiteral { "\"" (!["\\\n\r] | "\\" _)* "\"" }
  whitespace { std.whitespace+ }
}

@skip { whitespace }
