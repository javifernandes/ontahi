{
  "name": "@ontahi/explorer-react",
  "version": "0.1.0-alpha.4",
  "description": "Reusable React Explorer contracts and UI surfaces for Ontahi applications",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/explorer-react",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/explorer-react"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@ontahi/core": "workspace:*",
    "@ontahi/react": "workspace:*",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.576.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "lucide-react": "^0.576.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
