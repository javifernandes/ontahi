{
  "name": "@ontahi/runtime-http",
  "version": "1.0.0-alpha.18",
  "description": "HTTP transport adapters for Ontahi runtimes",
  "homepage": "https://github.com/javifernandes/ontahi/tree/main/packages/runtime-http",
  "license": "Apache-2.0",
  "author": "Javier Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javifernandes/ontahi.git",
    "directory": "packages/runtime-http"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./event-egress": {
      "types": "./dist/event-egress.d.ts",
      "import": "./dist/event-egress.js",
      "require": "./dist/event-egress.js"
    },
    "./ingress": {
      "types": "./dist/ingress.d.ts",
      "import": "./dist/ingress.js",
      "require": "./dist/ingress.js"
    },
    "./node": {
      "types": "./dist/node-server.d.ts",
      "import": "./dist/node-server.js",
      "require": "./dist/node-server.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.build.json",
    "build:watch": "pnpm exec tsc -p tsconfig.build.json --watch",
    "test": "pnpm exec vitest run",
    "test:coverage": "pnpm exec vitest run --coverage",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec tsc -p tsconfig.json",
    "lint": "pnpm exec eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm exec eslint \"src/**/*.ts\" --fix --max-warnings 0"
  },
  "dependencies": {
    "@ontahi/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
